# Optional stack settings for docker/compose.yaml. Defaults work without any file.
# Run the following commands from docker/.
# Use: docker compose --env-file compose.env up --build   (copy this file to compose.env first)
# Only the explicit stack/owner/public settings below are read; DATABASE_URL, DATABASE_PASSWORD and GW2_API_KEY from a root .env
# are never passed to the containers. Enter the GW2 key in the browser, not here.

# Host port for the frontend (the only published port). Default 8088; leave empty for an ephemeral port.
GW2_STACK_HTTP_PORT=8088
# Host interface for that port. Default loopback only.
GW2_STACK_HTTP_BIND=127.0.0.1
# Password for the stack's own PostgreSQL (not published to the host). Default is a local-only value.
GW2_STACK_DB_PASSWORD=change-me-for-your-machine
# Maximum JDBC connections per backend process and maximum wait for a free connection.
GW2_STACK_DB_POOL_SIZE=8
GW2_STACK_DB_POOL_TIMEOUT_MS=15000
# Optional owner account GUID (backend GW2_OWNER_ACCOUNT_GUID). Blank grants nobody; malformed fails startup.
GW2_OWNER_ACCOUNT_GUID=
# Bounds for each container's stdout/stderr log: max size per file and number of files.
GW2_STACK_LOG_MAX_SIZE=10m
GW2_STACK_LOG_MAX_FILE=3
# Optional public operator facts baked into the static pages at build time; leave unset if unknown.
# VITE_OPERATOR_NAME= VITE_OPERATOR_ADDRESS= VITE_OPERATOR_COUNTRY= VITE_HOSTING_REGION=
# VITE_PUBLIC_DOMAIN= VITE_CONTACT_EMAIL=
