# Used with `-f docker/frontend/Dockerfile` and the repository root as context. Admit only what the
# image build needs; local state, dependencies, reports and history stay out.
**
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/public/**
!frontend/src/**
!docker/frontend/default.conf.template
# Never copy local state, even under src
**/.env
**/.env.*
**/node_modules
**/*.log
