# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# Optional for retained local entry points. Browser users enter their key in the app.
GW2_API_KEY=

DATABASE_URL=jdbc:postgresql://localhost:5432/your_database
DATABASE_USER=your_db_user
DATABASE_PASSWORD=your_db_password

# Optional. Directory where synced item icons are cached on disk.
# Defaults to <user home>/.nebet-gw2-tool/icons when unset.
ICON_CACHE_DIR=/path/to/icon/cache
