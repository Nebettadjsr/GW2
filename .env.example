# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

DATABASE_URL=jdbc:postgresql://localhost:5432/your_database
DATABASE_USER=your_db_user
DATABASE_PASSWORD=your_db_password
# Optional per-backend-process limits. Borrowing waits at most this many milliseconds.
DATABASE_POOL_SIZE=8
DATABASE_POOL_TIMEOUT_MS=15000

# Optional. Directory where synced item icons are cached on disk.
# Defaults to <user home>/.nebet-gw2-tool/icons when unset.
ICON_CACHE_DIR=/path/to/icon/cache
