{
  "name": "gw2-tool-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser client for the GW2 tool backend HTTP API (TARGET_ARCHITECTURE.md 4.1).",
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:browser": "node scripts/browser-smoke.mjs",
    "smoke:sync": "node scripts/sync-browser-smoke.mjs",
    "smoke:layout": "node scripts/layout-browser-smoke.mjs",
    "smoke:profit": "node scripts/profit-browser-smoke.mjs",
    "smoke:profit:live": "node scripts/profit-live-smoke.mjs",
    "smoke:discovery": "node scripts/discovery-browser-smoke.mjs",
    "smoke:discovery:live": "node scripts/discovery-live-smoke.mjs",
    "smoke:ecto": "node scripts/ecto-browser-smoke.mjs",
    "smoke:ecto:live": "node scripts/ecto-live-smoke.mjs",
    "smoke:account": "node scripts/account-browser-smoke.mjs",
    "smoke:icons": "node scripts/icon-browser-smoke.mjs",
    "smoke:favicon": "node scripts/favicon-browser-smoke.mjs",
    "check:icons:live": "node scripts/icon-live-check.mjs",
    "perf:profit-page": "node scripts/profit-page-perf.mjs"
  },
  "dependencies": {
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
