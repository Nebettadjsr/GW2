{
  "name": "gw2-tool-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser client for the GW2 tool backend HTTP API (see docs/ARCHITECTURE.md).",
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "smoke:ci": "node scripts/run-desktop-journeys.mjs",
    "smoke:browser": "node scripts/browser-smoke.mjs",
    "smoke:sync": "node scripts/sync-browser-smoke.mjs",
    "smoke:stack": "node scripts/stack-browser-smoke.mjs",
    "smoke:layout": "node scripts/layout-browser-smoke.mjs",
    "smoke:profit": "node scripts/profit-browser-smoke.mjs",
    "smoke:profit:refresh": "node scripts/profit-refresh-browser-smoke.mjs",
    "smoke:profit:live": "node scripts/profit-live-smoke.mjs",
    "check:profit:envelope": "node scripts/profit-envelope-live-check.mjs",
    "smoke:discovery": "node scripts/discovery-browser-smoke.mjs",
    "smoke:discovery:live": "node scripts/discovery-live-smoke.mjs",
    "smoke:ecto": "node scripts/ecto-browser-smoke.mjs",
    "smoke:ecto:live": "node scripts/ecto-live-smoke.mjs",
    "smoke:account": "node scripts/account-browser-smoke.mjs",
    "smoke:icons": "node scripts/icon-browser-smoke.mjs",
    "smoke:favicon": "node scripts/favicon-browser-smoke.mjs",
    "check:icons:live": "node scripts/icon-live-check.mjs"
  },
  "dependencies": {
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "editorconfig": {
      "minimatch": "~11.0.5"
    },
    "glob": {
      "minimatch": "^11.0.5"
    },
    "js-beautify@2.0.3": {
      "glob": "14.0.6"
    }
  }
}
