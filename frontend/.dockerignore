# Admit only what the image build needs; local state, dependencies, reports and history stay out.
**
!package.json
!package-lock.json
!index.html
!tsconfig.json
!vite.config.ts
!public/**
!src/**
!nginx/default.conf.template
# Never copy local state, even under src
**/.env
**/.env.*
**/node_modules
**/*.log
