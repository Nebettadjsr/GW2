# Static frontend + same-origin /api forwarding (ADR-011). Rendered by the Nginx image's
# envsubst entrypoint; only ${GW2_BACKEND_ORIGIN} is substituted.
# Minimal access log: method, path WITHOUT the query string, status, sizes and timing. No client
# address, Referer, User-Agent, Cookie, Origin, X-GW2-API-Key, X-Account-Context or bodies are logged.
map $request_uri $gw2_log_path {
    "~^(?<p>[^?]*)" $p;
    default "-";
}
log_format gw2_minimal '$request_method $gw2_log_path $status $body_bytes_sent ${request_time}s';

server {
    listen 8080;
    access_log /dev/stdout gw2_minimal;
    # Nginx appends request/query/referrer context even to emerg allocation errors. Discard this
    # server's raw error stream at every level; keep the global startup/process log and the
    # query-free access status/size/time diagnostics above.
    error_log /dev/null;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;

    # Default non-indexable boundary. `add_header` in a location replaces every inherited one, so the
    # header is repeated in each location below; `always` covers error statuses too. No robots.txt
    # Disallow (crawlers must fetch pages to see noindex) and no sitemap.
    add_header X-Robots-Tag "noindex, nofollow" always;

    location /api/ {
        # No URI part: path and query are forwarded unchanged.
        # Docker's embedded DNS refreshes the service address after backend-only recreation.
        resolver 127.0.0.11 valid=5s ipv6=off;
        resolver_timeout 5s;
        set $gw2_backend ${GW2_BACKEND_ORIGIN};
        proxy_pass $gw2_backend;
        # The browser's own Host (including a nonstandard published port) is what the backend's
        # same-origin guard compares with Origin. $host would drop the port; the default would send
        # the upstream's own name.
        proxy_set_header Host $http_host;
        # Origin, Cookie, X-GW2-API-Key, X-Account-Context and the body pass unchanged by default;
        # Set-Cookie returns unchanged. No X-Forwarded-* (the backend does not trust them), no CORS.
        proxy_http_version 1.1;
        add_header X-Robots-Tag "noindex, nofollow" always;
    }

    # A missing hashed asset is a 404, never the HTML shell.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Robots-Tag "noindex, nofollow" always;
    }

    # No robots.txt and no sitemap exist: answer 404 rather than the HTML shell.
    location ~ ^/(robots\.txt|sitemap.*\.xml)$ {
        add_header X-Robots-Tag "noindex, nofollow" always;
        return 404;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
        add_header X-Robots-Tag "noindex, nofollow" always;
    }

    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
        add_header X-Robots-Tag "noindex, nofollow" always;
    }
}
