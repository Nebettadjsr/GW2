# IntelliJ
.idea/
*.iml

# Build output
out/
target/
build/
frontend/coverage/
.coverage
.pytest_cache/
.github/scripts/__pycache__/
# Local state left by the retired Python workflow; the tracked implementation
# is preserved at the pre-github-flow tag.
workflow_service/
agent/docker/
agent/runtime/
coverage-input/
coverage-kpi/
local-snapshots/
backend/target/perf/
quality-reports/
container-perf-out/
.jqwik-database*

# OS junk
.DS_Store
Thumbs.db

# Logs
*.log

# Environment configuration (contains secrets; .env.example stays tracked)
.env
compose.env

# SSH keys downloaded from the Oracle Console; keep the actual files outside the repository.
/ssh-key-*.key
/ssh-key-*.key.pub

# Private local deployment guide, including operator credentials and SSH key.
/ORACLE_DEPLOYMENT_LOCAL.md

# Derived/rebuildable data (auto-rebuilt by craft.CraftingGraphCache.load() when absent)
crafting_graph_cache.json
.aider*

# Python helper bytecode is generated, never source.
__pycache__/
*.py[cod]

# Historical local experiment output may contain account-derived labels; keep it out of Git.
frontend/.interaction-recordings/
frontend/.journey-runs/
