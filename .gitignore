# IntelliJ
.idea/
*.iml

# Build output
out/
target/
build/

# OS junk
.DS_Store
Thumbs.db

# Logs
*.log
# ...except the orchestrator's daily append-only log, which is a
# committed historical record, not disposable output.
!agent/logs/*.log

# Environment configuration (contains secrets; .env.example stays tracked)
.env

#AI operations
agent/runtime/artifacts/*
!agent/runtime/artifacts/.gitkeep
agent/runtime/**/__pycache__/

# Derived/rebuildable data (auto-rebuilt by craft.CraftingGraphCache.load() when absent)
crafting_graph_cache.json
.aider*
