      {
        "parameters": {
          "jsCode": "const incoming = $input.first().json ?? {};\nconst submission = $(\"Submit Final CI Task\").first().json ?? {};\nconst readiness = $(\"Fetch Final CI Readiness\").first().json ?? {};\nconst callback = incoming.body?.task_id ? incoming.body : (incoming.task_id ? incoming : null);\nconst terminal = [\"completed\", \"failed\", \"interrupted\"].includes(callback?.status);\nconst task = terminal ? callback : ([\"completed\", \"failed\", \"interrupted\"].includes(submission.status) ? submission : null);\nconst result = task?.result ?? {};\nconst error = task?.error ?? null;\nconst timedOut = !task;\nconst taskStatus = timedOut ? \"callback_timeout\" : (task.status ?? \"unknown\");\nconst ciStatus = timedOut ? \"CALLBACK_TIMEOUT\" : (result.status ?? (taskStatus === \"interrupted\" ? \"INTERRUPTED\" : taskStatus === \"failed\" ? \"TECHNICAL_FAILURE\" : \"UNKNOWN\"));\nreturn [{ json: {\n  story_id: result.story_id ?? readiness.story?.id ?? \"\",\n  task_id: task?.task_id ?? submission.task_id ?? \"\",\n  ci_status: ciStatus,\n  task_status: taskStatus,\n  commit_sha: result.sha ?? readiness.head_sha ?? \"\",\n  duration_seconds: result.duration_seconds ?? null,\n  command_summary: result.reason ?? \"\",\n  failures: result.failed_jobs ?? [],\n  diagnostic_report: result.report ?? \"\",\n  run_urls: result.run_urls ?? [],\n  exit_code: task?.exit_code ?? null,\n  error,\n  recovery_information: error?.recovery_action ?? (timedOut ? \"The callback timed out; the persisted CI task may still be waiting for GitHub Actions. Inspect this task ID and exact commit; do not submit a second task.\" : taskStatus === \"interrupted\" ? \"The bridge stopped during CI verification. Inspect this persisted task and its exact GitHub Actions run; CI is not restarted automatically.\" : \"\"),\n  result_source: result.result_source ?? \"persisted_bridge_task\",\n  operation_source: submission.operation_source ?? \"local_bridge_http\",\n  record_source: task?.record_source ?? submission.record_source ?? \"persisted_bridge_task\",\n  submission_disposition: submission.submission_disposition ?? \"unknown\",\n  final_ci_contract_sha256: readiness.final_ci_contract_sha256 ?? \"\"\n} }];"
        },
        "id": "fcf7b6f9-da55-42fe-b557-fdb7595c2d6e",
