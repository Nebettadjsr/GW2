{
  "id": "qMaNwA16S7Dcxi75",
  "name": "GW2 - Development Pipeline",
  "description": "Runs the development cycle one bridge step at a time. Starts by hand, or every hour from 17:35 to 06:35 when idle. Claude only runs within the GW2 Claude Budget.",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
