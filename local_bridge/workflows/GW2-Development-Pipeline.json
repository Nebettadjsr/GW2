    {
      "parameters": {
        "resume": "webhook",
        "httpMethod": "POST",
        "limitWaitTime": true,
        "resumeAmount": 30,
        "resumeUnit": "minutes",
        "options": {
          "noResponseBody": true
        }
      },
      "id": "00000000-0000-4000-8000-017999198260",
      "name": "Wait for Step",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1320,
        -120
      ],
      "webhookId": "6f9d2c1e-5b4a-4c3d-9e8f-7a6b5c4d3e2f"
    },
    {
      "parameters": {
        "jsCode": "// A callback carries the finished step in `body`. When the Wait times out, the\n// still-running task passes through instead and the next request re-attaches to it.\nconst item = $input.first().json;\nconst step = item.body ?? item;\nconst running = step.status === 'running';\nconst exhausted = $runIndex >= 200;\nreturn [{ json: {\n  step: step.step,\n  story_id: step.story_id,\n  status: step.status,\n  outcome: running ? 'waiting' : step.outcome,\n  phase: step.phase,\n  reason: exhausted ? 'Loop guard reached (200 iterations); rerun the pipeline to continue.' : step.reason,\n  continue: !exhausted && (running || step.proceed === true),\n  budget: step.budget,\n  task: step,\n} }];"
      },
      "id": "490d35e5-93a7-512d-b06d-08a1cd07beb0",
      "name": "Record Step",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
