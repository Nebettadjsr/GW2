      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "sSJvxExuzE2rWZg8",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.status === 'running' }}",
              "rightValue": true,
              "operator": {
