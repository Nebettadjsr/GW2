    {
      "parameters": {
        "jsCode": "// A callback carries the finished step in `body`. When the Wait times out, the\n// still-running task passes through instead and the next request re-attaches to it.\nconst item = $input.first().json;\nconst step = item.body ?? item;\nconst running = step.status === 'running';\nconst exhausted = $runIndex >= 200;\nreturn [{ json: {\n  step: step.step,\n  story_id: step.story_id,\n  status: step.status,\n  outcome: running ? 'waiting' : step.outcome,\n  phase: step.phase,\n  reason: exhausted ? 'Loop guard reached (200 iterations); rerun the pipeline to continue.' : step.reason,\n  continue: !exhausted && (running || step.proceed === true),\n  task: step,\n} }];"
      },
