      "credentials": {
        "httpHeaderAuth": {
          "id": "sSJvxExuzE2rWZg8",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ !$json.running_task && (!$json.last_step_request_at || Date.now() - new Date($json.last_step_request_at).getTime() > 120000) }}",
