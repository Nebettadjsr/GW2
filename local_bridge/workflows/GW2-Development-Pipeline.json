            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.continue }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "6d7e2bc1-b49c-5426-8e7c-a5cf00ecfcf8",
