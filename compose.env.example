# Optional stack settings for compose.yaml. Defaults work without any file.
# Use: docker compose --env-file compose.env up --build   (copy this file to compose.env first)
# Only GW2_STACK_* names are read; DATABASE_URL, DATABASE_PASSWORD and GW2_API_KEY from a root .env
# are never passed to the containers. Enter the GW2 key in the browser, not here.

# Host port for the frontend (the only published port). Default 8088; leave empty for an ephemeral port.
GW2_STACK_HTTP_PORT=8088
# Host interface for that port. Default loopback only.
GW2_STACK_HTTP_BIND=127.0.0.1
# Password for the stack's own PostgreSQL (not published to the host). Default is a local-only value.
GW2_STACK_DB_PASSWORD=change-me-for-your-machine
